---
// The billboard: one featured card, its clip on the monitor, what it does and the two ways in.
import Monitor from './Monitor.astro';
import { clipOf, cardOf, catOf, urlOf } from '../lib/data.mjs';
const { item } = Astro.props;
const c = cardOf(item);
---
<section class="billboard" aria-label={`Featured: ${c.name}`}>
  <Monitor clip={clipOf(item)} name={c.name} ch={c.ch} autoplay />
  <div class="billboard-copy">
    <p class="billboard-kind">{catOf(item.category).label}</p>
    <h2 class="billboard-name"><a href={urlOf(item)}>{c.name}</a></h2>
    <p class="billboard-effect">{item.effect}</p>
    <div class="actions"><a class="btn btn-primary" href={`${urlOf(item)}#pi`}><span>Get the prompt</span></a><a class="btn" href={`/${item.category}`}><span>All {catOf(item.category).label.toLowerCase()} cards</span></a></div>
  </div>
</section>
