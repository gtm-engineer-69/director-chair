---
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import Icon from '../components/Icon.astro';
import { items, groups, inCat, bySlug, catOf, clipOf, tileOf, urlOf, clipsFirst } from '../lib/data.mjs';
// the constellation: [slug, shape, hidden on small screens, desktop x y w opacity, small-screen x y w]
const sky = [
  ['dolly-in', '', 0, '14%', 19, '216px', 1, '6%', 12, '150px'], ['awe', 'p', 0, '33%', 17, '92px', 1, '58%', 10, '64px'], ['orbit', '', 0, '45.5%', 23, '112px', 0.4, '40%', 27, '84px'],
  ['laughter', 's', 0, '58%', 11, '76px', 1, '80%', 21, '52px'], ['tilt-up', 'p', 1, '66%', 25, '60px', 0.22], ['tracking-shot', '', 0, '78%', 30, '168px', 1, '62%', 67, '120px'],
  ['handheld-shot', '', 1, '8%', 47, '84px', 0.14], ['eye-roll', 's', 1, '86%', 56, '64px', 0.5], ['pan', '', 0, '22%', 68, '128px', 0.7, '8%', 66, '96px'],
  ['determination', 'p', 0, '71%', 66, '96px', 1, '14%', 80, '72px'], ['slow-zoom-in', '', 0, '55%', 75, '84px', 1, '42%', 77, '76px'], ['crash-zoom', 's', 0, '39%', 76, '88px', 1, '72%', 84, '64px'],
  ['push-past', '', 0, '9%', 90, '192px', 1, '38%', 93, '130px'], ['dolly-out', '', 1, '58%', 92, '144px', 1],
].map(([slug, shape, d, x, y, w, o, mx, my, mw]) => ({ item: bySlug(slug), shape, d, style: `--x:${x};--y:${y};--w:${w};--o:${o}` + (mx ? `;--mx:${mx};--my:${my};--mw:${mw}` : '') })).filter((f) => f.item);
// a row leads with the cards named here, then the cards with a clip
const LEAD = { move: ['dolly-in', 'dolly-out', 'slow-zoom-in', 'push-past', 'orbit', 'pan', 'tilt-up', 'tracking-shot', 'handheld-shot'], expression: ['awe', 'laughter', 'determination', 'eye-roll', 'anxiety', 'confusion', 'flirtation', 'disgust'] };
const row = (id) => {
  const lead = (LEAD[id] || []).map(bySlug).filter(Boolean);
  // hooks open on what to say; the ones that borrow a camera clip follow
  const rest = id === 'hook' ? [...inCat(id)].sort((a, b) => (a.shown_with ? 1 : 0) - (b.shown_with ? 1 : 0)) : clipsFirst(inCat(id));
  return { cat: catOf(id), list: [...lead, ...rest.filter((i) => !lead.includes(i))].slice(0, 12) };
};
// home stays calm: three shelves and the first-video path, then every shelf one tap away in All groups
const first = ['move', 'hook', 'expression'].map(row);
const step = (verb, target) => (typeof target === 'string' ? { verb, href: `/${target}`, name: catOf(target).plural } : { verb, href: urlOf(target), name: tileOf(target).name });
const start = [step('Pick the model for the shot.', bySlug('which-model-for-video')), step('Make the first frame.', bySlug('guide-shot-from-first-frame')), step('Choose how close the camera is.', 'shot'),
  step('Add one camera move.', 'move'), step('Set the light.', 'light'), step('Open on a hook.', 'hook'), step('Give it an arc.', 'script'), step('Caption it and cut it.', 'effect'), step('Check it before you post.', 'publish')];
---
<Base title="Director Chair: the video craft library for AI video" description={`A free, open library of ${items.length} cards of video craft for AI video: shots, moves, light, looks, hooks, scripts and presets, each with a prompt ready to paste for your model.`} path="/">
  <section class="hero" data-hero>
    {sky.map((f, n) => { const c = clipOf(f.item); return (
      <a class:list={['c', f.shape, f.d && 'd']} href={urlOf(f.item)} aria-label={tileOf(f.item).name} style={f.style}>
        {n === 0 ? <video src={c.media.card} poster={c.media.card_poster} muted loop playsinline preload="none" data-autoplay width="480" height="270"></video> : <img src={c.media.card_poster} alt="" width="480" height="270" />}
      </a>); })}
    <div class="core">
      <h1>Every move, hook and look,<br /> ready to paste.</h1>
      <form class="search" id="search" role="search" action="/" data-search>
        <label><Icon name="search" /><input type="search" name="q" autocomplete="off" placeholder={`Search ${items.length} video-craft cards`} aria-label="Search the library" /></label>
        <button class="pill round" aria-label="Search"><Icon name="arrow-right" /></button>
      </form>
    </div>
  </section>
  <script is:inline>
  // keep the frames clear of the sentence and the field at any window size: a frame that comes too close shrinks toward its own outer corner, and steps out when that is not enough
  (() => {
    const hero = document.querySelector('[data-hero]'); const pad = 24;
    const fit = () => {
      const core = [...hero.querySelectorAll('.core h1, .core form')].map((e) => e.getBoundingClientRect());
      const cx = (core[0].left + core[0].right) / 2; const cy = (core[0].top + core[1].bottom) / 2;
      const hit = (r) => core.some((b) => r.left < b.right + pad && r.right > b.left - pad && r.top < b.bottom + pad && r.bottom > b.top - pad);
      for (const c of hero.querySelectorAll('.c')) {
        c.style.transform = ''; c.style.visibility = '';
        const r = c.getBoundingClientRect(); if (!r.width || !hit(r)) continue;
        c.style.transformOrigin = `${(r.left + r.right) / 2 < cx ? 'left' : 'right'} ${(r.top + r.bottom) / 2 < cy ? 'top' : 'bottom'}`;
        if (![0.8, 0.65, 0.5].some((k) => { c.style.transform = `scale(${k})`; return !hit(c.getBoundingClientRect()); })) { c.style.transform = ''; c.style.visibility = 'hidden'; }
      }
    };
    fit(); addEventListener('resize', fit); document.fonts && document.fonts.ready.then(fit);
  })();
  </script>
  <section class="results" data-results-wrap hidden aria-live="polite">
    <p class="count" data-results-meta></p>
    <div class="grid" data-results></div>
    <p class="empty" data-noresults hidden>No card by that name. Try a move, a light or a hook.</p>
  </section>
  <div data-library>
    {first.map((r, n) => <Row title={r.cat.plural} href={`/${r.cat.id}`} count={r.cat.count} items={r.list} lazy={n > 0} />)}
    <Row title="Your first video, in nine cards" id="start">
      {start.map((s) => <a class="tile" href={s.href}><p>{s.verb}</p><span class="name">{s.name}</span><span class="act">Open <Icon name="arrow-right" /></span></a>)}
    </Row>
    <section class="row" id="groups">
      <header><h2>All groups</h2><a class="see" href="/board">Open the board <Icon name="arrow-right" /></a></header>
      <div class="index">{groups.map((g) => <div><h3>{g.name}</h3>{g.cats.map((c) => <a href={`/${c.id}`}>{c.plural} <span>{c.count}</span></a>)}</div>)}</div>
    </section>
  </div>
</Base>
