---
import Base from '../layouts/Base.astro';
import Win from '../components/Win.astro';
import Tile from '../components/Tile.astro';
import Billboard from '../components/Billboard.astro';
import Row from '../components/Row.astro';
import Icon from '../components/Icon.astro';
import { items, groups, cats, inCat, bySlug, catOf, clipOf, cardOf, urlOf, groupOf, LOGO } from '../lib/data.mjs';
const featured = bySlug('dolly-in');
const withClipFirst = (list) => [...list].sort((a, b) => (clipOf(b) ? 1 : 0) - (clipOf(a) ? 1 : 0));
// one row per group, the cards with a clip first
const rows = groups.map((g) => ({ g, list: withClipFirst(items.filter((i) => g.cats.some((c) => c.id === i.category))).slice(0, 14) }));
const step = (verb, target) => (typeof target === 'string'
  ? { verb, href: `/${target}`, text: `${catOf(target).label}, ${catOf(target).count} cards` }
  : { verb, href: urlOf(target), text: target.name });
const start = [step('Pick the model', bySlug('which-model-for-video')), step('Make the first frame', bySlug('guide-shot-from-first-frame')), step('Choose the shot size', 'shot'),
  step('Add one camera move', 'move'), step('Set the light', 'light'), step('Open on a hook', 'hook'), step('Give it an arc', 'script'), step('Caption and cut', 'effect'), step('Check before posting', 'publish')];
---
<Base title="Director Chair: the video craft library for AI video" description={`A free, open library of ${items.length} cards of video craft for AI video: shots, moves, light, looks, hooks, scripts and presets, each with a prompt ready to paste for your model.`} path="/" current="Library">
  <Win class="win-main" title="Library" meta={`${items.length} cards`} tint="var(--bar-yellow)" level={0}>
    <div class="lockup"><img src={LOGO} alt="" width="60" height="60" /><span>Director Chair</span></div>
    <div class="hero">
      <h1 class="display line1"><span>Every move, hook and look,</span> <span class="hl">ready to paste.</span></h1>
      <div class="hero-copy">
        <p class="lede">A free, open library of video craft for AI video. Pick a card, <mark>copy the prompt for your model</mark>, paste it.</p>
        <form class="search" role="search" action="/" data-search><Icon name="search" /><label class="vh" for="q">Search the library</label><input id="q" name="q" type="search" autocomplete="off" placeholder="Search: dolly in, golden hour, curiosity gap" /><kbd>/</kbd></form>
        <div class="actions">
          <a class="btn btn-primary" href="#start"><span>Start here: your first video</span></a>
          <a class="btn" href="/board"><span>Open the board</span></a>
        </div>
        <p class="small">Free. No account, no newsletter, nobody will call you.</p>
      </div>
      <Billboard item={featured} />
    </div>
    <nav class="bars" aria-label="Library groups">
      {groups.map((g) => <a class={g.on} style={`--tint:${g.tint}`} href={g.href}><span>{g.name}</span><b>{g.count}</b></a>)}
    </nav>
  </Win>
  <section class="win" data-results-win hidden aria-live="polite">
    <header class="win-bar"><span class="win-swatch"></span><h2 class="win-title">Search</h2><span class="win-meta" data-results-meta></span></header>
    <div class="win-body"><div class="grid" data-results></div><p class="nosignal" data-noresults hidden>No signal on that channel. Try a move, a light, a hook.</p></div>
  </section>
  <Win id="start" title="Start here" meta="your first video, in nine cards" tint="var(--bar-yellow)">
    <ol class="path">{start.map((s) => <li><span>{s.verb}</span> <a href={s.href}>{s.text}</a></li>)}</ol>
  </Win>
  {rows.map((r, n) => <Row title={r.g.name} meta={`${r.g.count} cards`} tint={r.g.tint} href={r.g.href} items={r.list} through={!r.g.on} lazy={n > 0} />)}
  <Win title="Everything" meta={`${cats.length} shelves`} tint="var(--bar-grey)">
    <ul class="shelves">{groups.map((g) => <li><b>{g.name}</b> {g.cats.map((c) => <a href={`/${c.id}`}>{c.label} <span>{c.count}</span></a>)}</li>)}</ul>
  </Win>
</Base>
