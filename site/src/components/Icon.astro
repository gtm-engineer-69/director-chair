---
// pixelarticons (MIT), inlined by name from src/icons
const files = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const { name } = Astro.props;
const raw = files[`../icons/${name}.svg`];
if (!raw) throw new Error(`no icon ${name}`);
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---
<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" set:html={inner} />
