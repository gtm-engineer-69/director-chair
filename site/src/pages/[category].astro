---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { cats, inCat, groupOf, clipsFirst, unique } from '../lib/data.mjs';
export const getStaticPaths = () => cats.map((cat) => ({ params: { category: cat.id }, props: { cat } }));
const { cat } = Astro.props;
const g = groupOf(cat.id);
const list = inCat(cat.id);
const subs = [...new Set(list.map((i) => i.group || cat.label))];
const names = list.slice(0, 4).map((i) => i.name).join(', ');
---
<Base title={`${cat.label}: ${cat.count} cards with prompts | Director Chair`} description={`${cat.count} ${cat.label.toLowerCase()} cards for AI video (${names} and more), each with a prompt ready to paste for your model.`} path={`/${cat.id}`}>
  <div class="page">
    <h1>{cat.plural}</h1>
    <p class="lead">{cat.count} cards in {g.name}. Each one has a prompt ready to paste.</p>
    {g.cats.length > 1 && <nav class="subnav" aria-label={`${g.name} shelves`}>{g.cats.map((c) => <a class="pill plain" href={`/${c.id}`} aria-current={c.id === cat.id ? 'page' : undefined}>{c.plural}</a>)}</nav>}
  </div>
  {subs.map((sub) => (
    <section class="row">
      {subs.length > 1 && <header><h2>{sub}</h2></header>}
      <div class="grid">{unique(clipsFirst(list.filter((i) => (i.group || cat.label) === sub))).map((u) => <Tile item={u.item} words={u.words} />)}</div>
    </section>
  ))}
</Base>
