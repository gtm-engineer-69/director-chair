---
// A row: a title, "See all" at its end, one line of uniform tiles.
import Icon from './Icon.astro';
import Tile from './Tile.astro';
import { unique } from '../lib/data.mjs';
const { title, href, count, items = [], lazy = true, id } = Astro.props;
---
<section class="row" id={id}>
  <header><h2>{title}</h2>{href && <a class="see" href={href}>See all {count} <Icon name="arrow-right" /></a>}</header>
  <div class="rail" tabindex="0" role="group" aria-label={title}>{unique(items).map((u) => <Tile item={u.item} words={u.words} lazy={lazy} />)}<slot /></div>
</section>
