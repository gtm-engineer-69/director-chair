---
import Base from '../layouts/Base.astro';
import Win from '../components/Win.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { cats, inCat, groupOf } from '../lib/data.mjs';
export const getStaticPaths = () => cats.map((cat) => ({ params: { category: cat.id }, props: { cat } }));
const { cat } = Astro.props;
const g = groupOf(cat.id);
const list = inCat(cat.id);
const subs = [...new Set(list.map((i) => i.group || cat.label))];
const names = list.slice(0, 4).map((i) => i.name).join(', ');
---
<Base title={`${cat.label}: ${cat.count} cards with prompts | Director Chair`} description={`${cat.count} ${cat.label.toLowerCase()} cards for AI video (${names} and more), each with a prompt ready to paste for your model.`} path={`/${cat.id}`} current={cat.id === 'guide' ? 'Guides' : 'Library'}>
  <div class="item-head">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Library</a><Icon name="chevron-right" /><a href={g.href}>{g.name}</a></nav>
    <h1 class="title">{cat.label} <small>{cat.count} cards</small></h1>
    {g.cats.length > 1 && <nav class="tabs tabs-nav" aria-label={`${g.name} shelves`}>{g.cats.map((c) => <a class="tab" href={`/${c.id}`} aria-current={c.id === cat.id ? 'page' : undefined}>{c.label}</a>)}</nav>}
  </div>
  {subs.map((sub) => {
    const own = list.filter((i) => (i.group || cat.label) === sub);
    return <Win title={sub} meta={`${own.length} cards`} tint={g.tint}><div class="grid">{own.map((i) => <Card item={i} />)}</div></Win>;
  })}
</Base>
