---
import Base from '../layouts/Base.astro';
import Prompt from '../components/Prompt.astro';
import { cats, inCat, models, tileOf } from '../lib/data.mjs';
import { kindOf } from '../lib/prompt.mjs';
// one slot per shelf whose cards go into an image or video prompt
const slots = cats.map((cat) => ({ cat, list: inCat(cat.id).filter((i) => kindOf(i, models) === 'shot') })).filter((s) => s.list.length && !['preset', 'guide'].includes(s.cat.id));
---
<Base title="Director's board: build one prompt from many cards | Director Chair" description="Pick one of each (shot, angle, move, light, look, expression, hook, transition) and get one complete prompt for your model. The address holds your board, so you can share it." path="/board">
  <div data-board>
    <article class="card">
      <div class="clip type" data-board-clip><p data-board-words>Pick one of each.</p><img alt="" hidden data-board-still /></div>
      <div class="info">
        <h1>Director's board</h1>
        <p class="lead">Pick one of each below. You get one complete prompt, written for the model you choose.</p>
        <p class="shown">The address holds your board, so you can share it.</p>
      </div>
      <Prompt board />
    </article>
    <section class="row"><header><h2>The board</h2></header>
      <form class="slots" data-slots>
        {slots.map((s) => (
          <label><span>{s.cat.label}</span>
            <select name={s.cat.id} data-slot={s.cat.id}><option value="">None</option>{s.list.map((i) => <option value={i.slug} data-name={tileOf(i).name} data-src={tileOf(i).still}>{i.name}</option>)}</select>
          </label>
        ))}
        <button class="pill" type="reset">Clear the board</button>
      </form>
    </section>
  </div>
</Base>
