---
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import { inCat, catOf, clipsFirst } from '../lib/data.mjs';
---
<Base title="No card here | Director Chair" description="This page does not exist. Search the library or browse the camera moves." path="/404" noindex>
  <div class="page"><h1>No card here.</h1><p class="lead">The page may have moved, or it never existed. The library is one step away.</p>
    <nav class="subnav" aria-label="Ways back"><a class="pill ink" href="/#search">Search the library</a><a class="pill" href="/board">Open the board</a></nav>
  </div>
  <Row title={catOf('move').plural} href="/move" count={catOf('move').count} items={clipsFirst(inCat('move')).slice(0, 12)} />
</Base>
