---
// One uniform 16:9 tile: the picture (its clip plays on hover or focus) or the card's words, the name on it, the Prompt action.
import Icon from './Icon.astro';
import { tileOf } from '../lib/data.mjs';
const { item, lazy = true, words = false } = Astro.props;
const t = tileOf(item, words);
---
<a class="tile" href={t.href} data-clip={t.clip || undefined}>
  {t.still ? <img src={t.still} alt="" width="480" height="270" loading={lazy ? 'lazy' : 'eager'} decoding="async" /> : <p>{t.text}</p>}
  <span class="name">{t.name}</span><span class="act">Prompt <Icon name="arrow-right" /></span>
</a>
