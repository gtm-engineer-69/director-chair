---
import '@fontsource-variable/figtree';
import '../styles/tokens.css';
import '../styles/mock.css';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import figtree from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import { groups, items, SITE, MARK, ICON, bySlug, clipOf } from '../lib/data.mjs';
const { title, description, path, image, twin, noindex = false } = Astro.props;
const canonical = SITE + (path === '/' ? '/' : path);
const og = SITE + (image || clipOf(bySlug('dolly-in')).media.poster);
const lead = ['Camera', 'Light and look', 'Edit', 'Story'].map((n) => groups.find((g) => g.name === n)).filter(Boolean);
const tools = [['Board', '/board'], ['Models', '/models'], ['Guides', '/guide'], ['About', '/about']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content="Director Chair" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#f2efea" />
<link rel="preload" as="font" type="font/woff2" href={figtree} crossorigin />
<link rel="icon" href={ICON} />
{twin && <link rel="alternate" type="text/markdown" href={twin} />}
<link rel="alternate" type="application/json" href="/api/library.json" title="The whole library as JSON" />
</head>
<body>
<a class="skip pill" href="#main">Skip to the content</a>
<header class="top">
  <a class="mark" href="/">{MARK && <img src={MARK} alt="" width="28" height="28" />}Director Chair</a>
  <a class="pill round" href="/#search" aria-label="Search the library" data-search-link><Icon name="search" /></a>
  <nav aria-label="Groups">{lead.map((g) => <a class="pill" href={g.href}>{g.name}</a>)}</nav>
  <details class="all" data-menu>
    <summary class="pill plain" aria-label="All groups and pages"><span>All groups</span><Icon name="chevron-down" class="i-chev" /><Icon name="menu" class="i-menu" /></summary>
    <div class="sheet">
      {groups.map((g) => <div><h3>{g.name}</h3>{g.cats.map((c) => <a href={`/${c.id}`}>{c.plural} <span>{c.count}</span></a>)}</div>)}
      <div><h3>Tools</h3>{tools.map(([t, h]) => <a href={h}>{t}</a>)}<a href="/director-chair-skill.zip" download>Agent skill</a></div>
    </div>
  </details>
</header>
<main id="main"><slot /></main>
<footer class="foot">
  <span>Director Chair. A free, open library for AI video. {items.length} cards. Made by the people behind <a href="https://notavideo.ai" rel="noopener">Not A Video</a>.</span>
  <span>Clips by <a href="https://aicameramovements.com/" rel="noopener">AI Camera Movements</a> and <a href="https://seedance-emotion-direction.vercel.app/" rel="noopener">Emotion Direction</a>, with permission.</span>
  <nav aria-label="Pages">{tools.map(([t, h]) => <a href={h}>{t}</a>)}<a href="/director-chair-skill.zip" download>Agent skill</a></nav>
</footer>
<script>import '../scripts/site.js';</script>
</body>
</html>
